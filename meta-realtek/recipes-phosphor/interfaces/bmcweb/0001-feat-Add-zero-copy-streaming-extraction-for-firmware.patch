@@ -267,10 +449,32 @@ class HttpBody::reader
                     boost::system::error_code& ec)
     {
         size_t extra = boost::beast::buffer_bytes(buffers);
-        for (const auto b : boost::beast::buffers_range_ref(buffers))
+
+        if (value.isPipeExtractionMode())
+        {
+            for (const auto b : boost::beast::buffers_range_ref(buffers))
+            {
+                const char* ptr = static_cast<const char*>(b.data());
+                if (!value.writeToPipe(ptr, b.size()))
+                {
+                    BMCWEB_LOG_ERROR("Pipe write failed");
+                    ec = boost::system::error_code(
+                        boost::system::errc::io_error,
+                        boost::system::system_category());
+                    return 0;
+                }
+            }
+            ec = {};
+            return extra;
+        }
+        else
         {
-            const char* ptr = static_cast<const char*>(b.data());
-            value.str() += std::string_view(ptr, b.size());
+            // String mode: append to string
+            for (const auto b : boost::beast::buffers_range_ref(buffers))
+            {
+                const char* ptr = static_cast<const char*>(b.data());
+                value.str() += std::string_view(ptr, b.size());
+            }
         }
         ec = {};
         return extra;
