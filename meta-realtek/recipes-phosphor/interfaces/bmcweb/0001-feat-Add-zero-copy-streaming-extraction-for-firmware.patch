+    // Streaming extraction support
+    FILE* extractPipe_ = nullptr;
+    std::string extractPath_;
+    bool usePipeExtraction_ = false;
+    size_t pipeWriteSize_ = 0;
+    bool extractionSucceeded_ = false;
+    bool cleanupDone_ = false;
+
   public:
     value_type() = default;
     explicit value_type(std::string_view s) : strBody(s) {}
     explicit value_type(EncodingType e) : encodingType(e) {}
     EncodingType encodingType = EncodingType::Raw;
 
+    bool enablePipeExtraction(const std::string& outputDir)
+    {
+        std::error_code ec;
+        if (mount("/run/initramfs", "/tmp/images/", nullptr, MS_BIND, nullptr) != 0)
+        {
+            BMCWEB_LOG_ERROR("Error occurred during mount /run/initramfs to {}", "/tmp/images");
+            return false;
+        }
+        BMCWEB_LOG_INFO("Successfully mounted /run/initramfs to {}", "/tmp/images");
+
+        std::filesystem::create_directories(outputDir, ec);
+        if (ec)
+        {
+            BMCWEB_LOG_ERROR("Failed to create directory: {}", ec.message());
+            umount("/tmp/images");
+            return false;
+        }
+
+        extractPath_ = outputDir;
+        std::string cmd = "tar -xf - -C " + outputDir + " --no-same-owner" + " 2>&1";
+        BMCWEB_LOG_INFO("Starting pipe extraction: {}", cmd);
+        extractPipe_ = popen(cmd.c_str(), "w");
+        if (!extractPipe_)
+        {
+            BMCWEB_LOG_ERROR("Failed to create extraction pipe: {}", strerror(errno));
+            std::filesystem::remove_all(outputDir, ec);
+            umount("/tmp/images");
+            return false;
+        }
+        usePipeExtraction_ = true;
+        pipeWriteSize_ = 0;
+        BMCWEB_LOG_INFO("Pipe extraction enabled to: {}", outputDir);
+        return true;
+    }
+
+    bool isPipeExtractionMode() const
+    {
+        return usePipeExtraction_;
+    }
+
+    const std::string& getExtractPath() const
+    {
+        return extractPath_;
+    }
+
+    size_t getPipeWriteSize() const
+    {
+        return pipeWriteSize_;
+    }
+
+    bool writeToPipe(const char* data, size_t size)
+    {
+        if (!extractPipe_)
+        {
+            return false;
+        }
+        size_t written = fwrite(data, 1, size, extractPipe_);
+        if (written != size)
+        {
+            BMCWEB_LOG_ERROR("Pipe write failed: written={}, expected={}", written, size);
+            return false;
+        }
+        pipeWriteSize_ += written;
+        if (pipeWriteSize_ % (64 * 1024) == 0)
+        {
+            fflush(extractPipe_);
+        }
+        return true;
+    }
+
+    bool closePipeExtraction()
+    {
+        BMCWEB_LOG_DEBUG("closePipeExtraction called, pipe={}, cleanupDone={}",
+                         static_cast<const void*>(extractPipe_), cleanupDone_);
+        if (!extractPipe_)
+        {
+            return true;
+        }
+        BMCWEB_LOG_INFO("Closing extraction pipe, total: {} bytes", pipeWriteSize_);
+        fflush(extractPipe_);
+        int status = pclose(extractPipe_);
+        extractPipe_ = nullptr;
+
+        if (status == -1 || WEXITSTATUS(status) != 0)
+        {
+            BMCWEB_LOG_ERROR("tar extraction failed with status {}", status);
+            extractionSucceeded_ = false;
+            cleanupExtractPath();
+            return false;
+        }
+
+        extractionSucceeded_ = true;
+        BMCWEB_LOG_INFO("Pipe extraction succeeded");
+        return true;
+    }
+
+    void cleanupExtractPath()
+    {
+        std::error_code ec;
+
+        if (cleanupDone_ || extractPath_.empty())
+        {
+            return;
+        }
+
+        BMCWEB_LOG_WARNING("Cleaning up extraction directory: {}", extractPath_);
+
+
+        // Remove the extraction directory
+        std::filesystem::remove_all(extractPath_, ec);
+        if (ec)
+        {
+            BMCWEB_LOG_ERROR("Failed to remove extraction directory {}: {}",
+                           extractPath_, ec.message());
+        }
+        else
+        {
+            BMCWEB_LOG_INFO("Successfully removed extraction directory: {}", extractPath_);
+        }
+
+        // Skip umount if already unmounted (e.g., double cleanup).
+        // EINVAL means the path is not a mount point, which is acceptable
+        // on a second call (already unmounted).
+        if (umount("/tmp/images") != 0)
+        {
+            if (errno != EINVAL)
+            {
+                BMCWEB_LOG_ERROR("Error {} occurred during umount /run/initramfs from /tmp/images", errno);
+            }
+            // EINVAL: already unmounted, silently ignore
+        }
+        else
+        {
+            BMCWEB_LOG_INFO("Successfully unmounted /run/initramfs from /tmp/images");
+        }
+        cleanupDone_ = true;
+    }
+
+    void markExtractionSuccess()
+    {
+        extractionSucceeded_ = true;
+        BMCWEB_LOG_INFO("Extraction marked as successful, will not cleanup: {}", extractPath_);
+    }
+
+    bool isExtractionSucceeded() const
+    {
+        return extractionSucceeded_;
+    }
+
