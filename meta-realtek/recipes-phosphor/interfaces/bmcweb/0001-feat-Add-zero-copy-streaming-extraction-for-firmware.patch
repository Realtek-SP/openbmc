+        // Detect firmware upload FIRST, before handling Expect: 100-continue.
+        // This ensures pendingOutputDir is set regardless of whether the client
+        // sent "Expect: 100-continue" header. If the client did send Expect,
+        // the code below will send 100-continue and return; afterDoWrite() will
+        // then find pendingOutputDir non-empty and call enablePipeExtraction().
+        // If the client did not send Expect, we send 100-continue ourselves to
+        // guarantee a clean separation between headers and body.
+        if constexpr (BMCWEB_FIRMWARE_STREAM_UPDATE)
+        {
+            if (target == "/redfish/v1/UpdateService/update")
+            {
+                std::string_view contentType =
+                    value[boost::beast::http::field::content_type];
+
+                if (contentType == "application/octet-stream")
+                {
+                    std::random_device rd;
+                    std::mt19937 gen(rd());
+                    std::uniform_int_distribution<uint32_t> dis(0, 0xFFFFFFFF);
+                    std::ostringstream oss;
+                    oss << std::hex << std::setfill('0') << std::setw(8) << dis(gen);
+                    std::string tmpid = oss.str();
+
+                    pendingOutputDir = "/tmp/images/" + tmpid;
+
+                    BMCWEB_LOG_INFO("Firmware upload detected, save in /tmp/images/{}",
+                                tmpid);
