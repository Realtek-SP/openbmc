@@ -797,8 +901,38 @@ class Connection :
 
         if (res.result() == boost::beast::http::status::continue_)
         {
-            // Reset the result to ok
+            // Reset the result to ok so the final response is not 100.
             res.result(boost::beast::http::status::ok);
+
+            // If a firmware stream upload was pending, set up the pipe now
+            // that the 100-continue has been delivered and the client is
+            // guaranteed to send body data in the next read cycle.
+            // This must happen here (after doWrite completes) rather than in
+            // afterReadHeaders() to prevent a double-doRead() race: calling
+            // doRead() both at the end of afterReadHeaders() and here would
+            // launch two concurrent async reads on the same socket, causing
+            // one to cancel the other (Operation canceled / tar short read).
+            if (!pendingOutputDir.empty())
+            {
+                if (parser && parser->get().body().enablePipeExtraction(
+                                  pendingOutputDir))
+                {
+                    BMCWEB_LOG_INFO("Enabled pipe extraction");
+                }
+                pendingOutputDir.clear();
+                if (parser)
+                {
+                    parser->body_limit(getContentLengthLimit());
+                }
+            }
+
+            // Cancel the timer started by doWrite() for 100-continue,
+            // and restart it fresh for the body read phase.
+            // Without this, the timer may expire while async_read_some is
+            // still pending, causing a race where afterTimerWait() sees
+            // operation_aborted and returns without calling hardClose().
+            // cancelDeadlineTimer();
+            timerStarted = false;
             doRead();
             return;
         }
