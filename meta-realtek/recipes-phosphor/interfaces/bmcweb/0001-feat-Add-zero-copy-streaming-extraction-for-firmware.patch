+inline int createDirectoryPathMemfd(const std::string& dirPath)
+{
+    int fd = memfd_create("image-dir-path", MFD_CLOEXEC);
+    if (fd < 0)
+    {
+        BMCWEB_LOG_ERROR("Failed to create memfd: {}", strerror(errno));
+        return -1;
+    }
+    std::string marker = "DIR:";
+    std::string fullPath = marker + dirPath;
+    if (write(fd, fullPath.c_str(), fullPath.size()) < 0)
+    {
+        BMCWEB_LOG_ERROR("Failed to write to memfd: {}", strerror(errno));
+        close(fd);
+        return -1;
+    }
+    lseek(fd, 0, SEEK_SET);
+    return fd;
+}
